<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:uWidgets.Styles;assembly=uWidgets"
             xmlns:viewModels="clr-namespace:Media.ViewModels"
             x:Class="Media.Views.Controls.NowPlayingExtraLarge"
             x:DataType="viewModels:NowPlayingViewModel">
    <UserControl.Resources>
        <GridLength x:Key="SliderPreContentMargin">0</GridLength>
        <GridLength x:Key="SliderPostContentMargin">0</GridLength>
        <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
        <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
        <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
        <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
        <CornerRadius x:Key="SliderThumbCornerRadius">6</CornerRadius>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.mediaBtn">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.playBtn">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAltHighBrush}" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.playBtn PathIcon.play">
            <Setter Property="RenderTransform" Value="translateX(2.25px)" />
        </Style>
        <Style Selector="Button.muteBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="Button.muteBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="Opacity" Value="1.0" />
        </Style>
        <Style Selector="Slider.timelineSlider">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
        </Style>
        <Style Selector="Slider.timelineSlider /template/ Thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="8,0">
        <!-- Left: Large Square Album Art (180x180) -->
        <Border Grid.Column="0"
                Width="180" Height="180"
                CornerRadius="20"
                ClipToBounds="True"
                Margin="0,0,24,0"
                VerticalAlignment="Center"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <Panel>
                <Image Source="{Binding AlbumArt}" Stretch="UniformToFill" IsVisible="{Binding HasAlbumArt}" />
                <PathIcon IsVisible="{Binding !HasAlbumArt}"
                          Width="60" Height="60"
                          RenderTransform="translateX(-3px)"
                          Opacity="0.85"
                          Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                          Data="{x:Static icons:WidgetIcons.MusicNote}" />
            </Panel>
        </Border>

        <!-- Right: Track Info, Timeline, Controls -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto" VerticalAlignment="Center">
            <!-- Row 0: App / Artist Header & Mute Button -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="26" Height="26"
                            CornerRadius="7"
                            IsVisible="{Binding HasAlbumArt}"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                        <Panel>
                            <PathIcon Width="14" Height="14"
                                      RenderTransform="translateX(-0.5px)"
                                      Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                                      Data="{x:Static icons:WidgetIcons.MusicNote}" />
                        </Panel>
                    </Border>
                    <TextBlock Text="{Binding ArtistOrApp}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="260" />
                </StackPanel>

                <Button Grid.Column="1"
                        Classes="muteBtn"
                        IsVisible="{Binding ShowMuteButton}"
                        Click="Mute_OnClick"
                        ToolTip.Tip="Mute / Unmute App Audio">
                    <PathIcon Width="14" Height="14" Data="{Binding MuteIcon}" />
                </Button>
            </Grid>

            <!-- Row 1: Track Title (Single line ellipsis) & Album -->
            <StackPanel Grid.Row="1" Spacing="2" Margin="0,0,0,12">
                <TextBlock Text="{Binding TrackTitle}"
                           ToolTip.Tip="{Binding TooltipText}"
                           FontSize="20"
                           FontWeight="Bold"
                           MaxLines="1"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Album}"
                           IsVisible="{Binding HasAlbum}"
                           FontSize="12"
                           Opacity="0.55"
                           MaxLines="1"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Row 2: Timeline Slider with Timestamps -->
            <Grid Grid.Row="2"
                  RowDefinitions="Auto,Auto"
                  IsVisible="{Binding ShowTimeline}"
                  Margin="0,0,0,14">
                <Slider x:Name="TimelineSlider"
                        Grid.Row="0"
                        Classes="timelineSlider"
                        IsEnabled="{Binding CanSeek}"
                        Minimum="0"
                        Maximum="{Binding SliderMaximum}"
                        Value="{Binding PositionSeconds}"
                        ToolTip.Tip="{Binding TimelineTooltip}"
                        Height="20"
                        ClipToBounds="False"
                        Margin="0" />
                <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0"
                               Text="{Binding PositionText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Opacity="0.6"
                               HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DurationText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Opacity="0.6"
                               HorizontalAlignment="Right" />
                </Grid>
            </Grid>

            <!-- Row 3: Playback Controls Trio (Centered) -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="20">
                <Button Classes="mediaBtn" Click="Prev_OnClick" ToolTip.Tip="Previous Track">
                    <PathIcon Width="14" Height="14"
                              Data="M.5 3.5A.5.5 0 0 0 0 4v8a.5.5 0 0 0 1 0V8.753l6.267 3.636c.54.313 1.233-.066 1.233-.697v-2.94l6.267 3.636c.54.314 1.233-.065 1.233-.696V4.308c0-.63-.693-1.01-1.233-.696L8.5 7.248v-2.94c0-.63-.692-1.01-1.233-.696L1 7.248V4a.5.5 0 0 0-.5-.5" />
                </Button>
                <Button Classes="playBtn" Click="PlayPause_OnClick" ToolTip.Tip="Play / Pause">
                    <PathIcon Width="18" Height="18" Classes.play="{Binding !IsPlaying}" Foreground="{DynamicResource SystemControlForegroundAltHighBrush}" Data="{Binding PlayPauseIcon}" />
                </Button>
                <Button Classes="mediaBtn" Click="Next_OnClick" ToolTip.Tip="Next Track">
                    <PathIcon Width="14" Height="14"
                              Data="M15.5 3.5a.5.5 0 0 1 .5.5v8a.5.5 0 0 1-1 0V8.753l-6.267 3.636c-.54.313-1.233-.066-1.233-.697v-2.94l-6.267 3.636C.693 12.703 0 12.324 0 11.693V4.308c0-.63.693-1.01 1.233-.696L7.5 7.248v-2.94c0-.63.693-1.01 1.233-.696L15 7.248V4a.5.5 0 0 1 .5-.5" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
