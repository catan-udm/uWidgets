<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Media.ViewModels"
             x:Class="Media.Views.Controls.NowPlayingSmall"
             x:DataType="viewModels:NowPlayingViewModel">
    <UserControl.Resources>
        <GridLength x:Key="SliderPreContentMargin">0</GridLength>
        <GridLength x:Key="SliderPostContentMargin">0</GridLength>
        <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
        <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
        <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
        <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
        <CornerRadius x:Key="SliderThumbCornerRadius">6</CornerRadius>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.mediaBtn">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.playBtn">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAltHighBrush}" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.muteBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="Button.muteBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="Opacity" Value="1.0" />
        </Style>
        <Style Selector="Slider.timelineSlider">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
        </Style>
        <Style Selector="Slider.timelineSlider /template/ Thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
        <!-- Row 0: Header with Album Art, Artist/Source, and Mute Button -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
            <Border Grid.Column="0"
                    Width="32" Height="32"
                    CornerRadius="8"
                    Margin="0,0,6,0"
                    ClipToBounds="True"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                <Panel>
                    <Image Source="{Binding AlbumArt}" Stretch="UniformToFill" IsVisible="{Binding HasAlbumArt}" />
                    <PathIcon IsVisible="{Binding !HasAlbumArt}" Width="15" Height="15"
                              Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                              Data="M6 13c0 1.105-1.12 2-2.5 2S1 14.105 1 13s1.12-2 2.5-2 2.5.895 2.5 2m9-2c0 1.105-1.12 2-2.5 2s-2.5-.895-2.5-2 1.12-2 2.5-2 2.5.895 2.5 2 M14 11V2h1v9zM6 3v10H5V3z M5 2.905a1 1 0 0 1 .9-.995l8-.8a1 1 0 0 1 1.1.995V3L5 4z" />
                </Panel>
            </Border>
            <TextBlock Grid.Column="1"
                       Text="{Binding ArtistOrApp}"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2"
                    Classes="muteBtn"
                    IsVisible="{Binding ShowMuteButton}"
                    Click="Mute_OnClick"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Mute / Unmute App Audio">
                <PathIcon Width="12" Height="12" Data="{Binding MuteIcon}" />
            </Button>
        </Grid>

        <!-- Row 1: Track Title (Single line ellipsis) -->
        <TextBlock Grid.Row="1"
                   Text="{Binding TrackTitle}"
                   FontSize="13"
                   FontWeight="Bold"
                   MaxLines="1"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   Margin="0,2,0,2" />

        <!-- Row 2: Slim Timeline Slider with Timestamps -->
        <Grid Grid.Row="2"
              RowDefinitions="Auto,Auto"
              IsVisible="{Binding ShowTimeline}"
              Margin="0,0,0,4">
            <Slider x:Name="TimelineSlider"
                    Grid.Row="0"
                    Classes="timelineSlider"
                    IsEnabled="{Binding CanSeek}"
                    Minimum="0"
                    Maximum="{Binding SliderMaximum}"
                    Value="{Binding PositionSeconds}"
                    ToolTip.Tip="{Binding TimelineTooltip}"
                    Height="20"
                    ClipToBounds="False"
                    Margin="0" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,1,0,0">
                <TextBlock Grid.Column="0"
                           Text="{Binding PositionText}"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Opacity="0.6"
                           HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DurationText}"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Opacity="0.6"
                           HorizontalAlignment="Right" />
            </Grid>
        </Grid>

        <!-- Row 3: Centered Playback Controls Trio (126px width, fits 136px perfectly) -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="14">
            <Button Classes="mediaBtn" Click="Prev_OnClick">
                <PathIcon Width="12" Height="12"
                          Data="M.5 3.5A.5.5 0 0 0 0 4v8a.5.5 0 0 0 1 0V8.753l6.267 3.636c.54.313 1.233-.066 1.233-.697v-2.94l6.267 3.636c.54.314 1.233-.065 1.233-.696V4.308c0-.63-.693-1.01-1.233-.696L8.5 7.248v-2.94c0-.63-.692-1.01-1.233-.696L1 7.248V4a.5.5 0 0 0-.5-.5" />
            </Button>
            <Button Classes="playBtn" Click="PlayPause_OnClick">
                <PathIcon Width="14" Height="14" Foreground="{DynamicResource SystemControlForegroundAltHighBrush}" Data="{Binding PlayPauseIcon}" />
            </Button>
            <Button Classes="mediaBtn" Click="Next_OnClick">
                <PathIcon Width="12" Height="12"
                          Data="M15.5 3.5a.5.5 0 0 1 .5.5v8a.5.5 0 0 1-1 0V8.753l-6.267 3.636c-.54.313-1.233-.066-1.233-.697v-2.94l-6.267 3.636C.693 12.703 0 12.324 0 11.693V4.308c0-.63.693-1.01 1.233-.696L7.5 7.248v-2.94c0-.63.693-1.01 1.233-.696L15 7.248V4a.5.5 0 0 1 .5-.5" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
