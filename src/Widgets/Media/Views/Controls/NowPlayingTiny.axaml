<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Media.ViewModels"
             x:Class="Media.Views.Controls.NowPlayingTiny"
             x:DataType="viewModels:NowPlayingViewModel"
             ToolTip.Tip="{Binding TooltipText}">
    <Grid RowDefinitions="*,Auto">
        <Button Grid.Row="0"
                Width="38"
                Height="38"
                Padding="0"
                CornerRadius="19"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="{DynamicResource SystemAccentColor}"
                Foreground="White"
                Click="PlayPause_OnClick">
            <PathIcon Width="15" Height="15" Foreground="White" Data="{Binding PlayPauseIcon}" />
        </Button>
        <ProgressBar Grid.Row="1"
                     IsVisible="{Binding ShowVisualizer}"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding PeakPercentage}"
                     Height="4"
                     MinWidth="24"
                     CornerRadius="2"
                     Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
    </Grid>
</UserControl>
