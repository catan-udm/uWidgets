<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Media.ViewModels"
             x:Class="Media.Views.Controls.NowPlayingTiny"
             x:DataType="viewModels:NowPlayingViewModel"
             ToolTip.Tip="{Binding TooltipText}">
    <UserControl.Resources>
        <GridLength x:Key="SliderPreContentMargin">0</GridLength>
        <GridLength x:Key="SliderPostContentMargin">0</GridLength>
        <x:Double x:Key="SliderHorizontalHeight">14</x:Double>
        <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
        <x:Double x:Key="SliderHorizontalThumbWidth">10</x:Double>
        <x:Double x:Key="SliderHorizontalThumbHeight">10</x:Double>
        <CornerRadius x:Key="SliderThumbCornerRadius">5</CornerRadius>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.playBtn">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAltHighBrush}" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.playBtn.noTimeline">
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
        </Style>
        <Style Selector="Button.playBtn PathIcon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>
        <Style Selector="Button.playBtn.noTimeline PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.playBtn PathIcon.play">
            <Setter Property="RenderTransform" Value="translateX(1.5px)" />
        </Style>
        <Style Selector="Button.playBtn.noTimeline PathIcon.play">
            <Setter Property="RenderTransform" Value="translateX(2px)" />
        </Style>
        <Style Selector="Slider.timelineSlider">
            <Setter Property="MinHeight" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
        </Style>
        <Style Selector="Slider.timelineSlider /template/ Thumb">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
        <Button Grid.Row="0"
                Classes="playBtn"
                Classes.noTimeline="{Binding !ShowTinyTimeline}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ToolTip.Tip="Play / Pause"
                Click="PlayPause_OnClick">
            <Border CornerRadius="999" ClipToBounds="True">
                <Panel>
                    <Image Source="{Binding AlbumArt}"
                           Stretch="UniformToFill"
                           IsVisible="{Binding HasAlbumArt}" />
                    <Border Background="#55000000"
                            IsVisible="{Binding HasAlbumArt}" />
                    <PathIcon Classes.play="{Binding !IsPlaying}"
                              Foreground="{DynamicResource SystemControlForegroundAltHighBrush}"
                              Data="{Binding PlayPauseIcon}" />
                </Panel>
            </Border>
        </Button>
        <Slider x:Name="TimelineSlider"
                Grid.Row="1"
                Classes="timelineSlider"
                IsVisible="{Binding ShowTinyTimeline}"
                IsEnabled="{Binding CanSeek}"
                Minimum="0"
                Maximum="{Binding SliderMaximum}"
                Value="{Binding PositionSeconds}"
                ToolTip.Tip="{Binding TimelineTooltip}"
                Height="14"
                ClipToBounds="False"
                Margin="2,2,2,0" />
    </Grid>
</UserControl>
