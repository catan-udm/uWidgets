<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Media.ViewModels"
             x:Class="Media.Views.Controls.NowPlayingTiny"
             x:DataType="viewModels:NowPlayingViewModel"
             ToolTip.Tip="{Binding TooltipText}">
    <UserControl.Styles>
        <Style Selector="Button.playBtn">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Slider.timelineSlider">
            <Setter Property="MinHeight" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Slider.timelineSlider /template/ Thumb">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
        </Style>
        <Style Selector="Slider.timelineSlider:pointerover /template/ Thumb">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
        <Button Grid.Row="0"
                Classes="playBtn"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="PlayPause_OnClick">
            <Panel>
                <Image Source="{Binding AlbumArt}"
                       Stretch="UniformToFill"
                       Width="44" Height="44"
                       IsVisible="{Binding HasAlbumArt}" />
                <Border Background="#55000000"
                        Width="44" Height="44"
                        IsVisible="{Binding HasAlbumArt}" />
                <PathIcon Width="16" Height="16"
                          Foreground="White"
                          Data="{Binding PlayPauseIcon}" />
            </Panel>
        </Button>
        <Slider x:Name="TimelineSlider"
                Grid.Row="1"
                Classes="timelineSlider"
                IsVisible="{Binding ShowTimeline}"
                IsEnabled="{Binding CanSeek}"
                Minimum="0"
                Maximum="{Binding SliderMaximum}"
                Value="{Binding PositionSeconds}"
                ToolTip.Tip="{Binding TimelineTooltip}"
                Height="10"
                Margin="2,0" />
    </Grid>
</UserControl>
