<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Media.ViewModels"
             x:Class="Media.Views.Controls.NowPlayingTiny"
             x:DataType="viewModels:NowPlayingViewModel"
             ToolTip.Tip="{Binding TooltipText}">
    <UserControl.Resources>
        <GridLength x:Key="SliderPreContentMargin">0</GridLength>
        <GridLength x:Key="SliderPostContentMargin">0</GridLength>
        <x:Double x:Key="SliderHorizontalHeight">16</x:Double>
        <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
        <x:Double x:Key="SliderHorizontalThumbWidth">10</x:Double>
        <x:Double x:Key="SliderHorizontalThumbHeight">10</x:Double>
        <CornerRadius x:Key="SliderThumbCornerRadius">5</CornerRadius>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.playBtn">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAltHighBrush}" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Slider.timelineSlider">
            <Setter Property="MinHeight" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
        </Style>
        <Style Selector="Slider.timelineSlider /template/ Thumb">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
        <Button Grid.Row="0"
                Classes="playBtn"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="PlayPause_OnClick">
            <Panel>
                <Image Source="{Binding AlbumArt}"
                       Stretch="UniformToFill"
                       Width="44" Height="44"
                       IsVisible="{Binding HasAlbumArt}" />
                <Border Background="#55000000"
                        Width="44" Height="44"
                        IsVisible="{Binding HasAlbumArt}" />
                <PathIcon Width="16" Height="16"
                          Foreground="{DynamicResource SystemControlForegroundAltHighBrush}"
                          Data="{Binding PlayPauseIcon}" />
            </Panel>
        </Button>
        <Slider x:Name="TimelineSlider"
                Grid.Row="1"
                Classes="timelineSlider"
                IsVisible="{Binding ShowTimeline}"
                IsEnabled="{Binding CanSeek}"
                Minimum="0"
                Maximum="{Binding SliderMaximum}"
                Value="{Binding PositionSeconds}"
                ToolTip.Tip="{Binding TimelineTooltip}"
                Height="16"
                ClipToBounds="False"
                Margin="2,0" />
    </Grid>
</UserControl>
