<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:uWidgets.Views.Controls;assembly=uWidgets"
             xmlns:locales="clr-namespace:Media.Locales"
             xmlns:viewModels="clr-namespace:Media.ViewModels"
             x:Class="Media.Views.Settings.NowPlayingSettings"
             x:DataType="viewModels:NowPlayingSettingsViewModel">
    <ScrollViewer>
        <StackPanel Orientation="Vertical" Spacing="5">
            <controls:Setting Title="{x:Static locales:Locale.Media_ShowTimeline}">
                <ToggleSwitch IsChecked="{Binding ShowTimeline}" />
            </controls:Setting>
            <controls:Setting Title="{x:Static locales:Locale.Media_ShowVolume}">
                <ToggleSwitch IsChecked="{Binding ShowMuteButton}" />
            </controls:Setting>
            <controls:Setting Title="{x:Static locales:Locale.Media_PrefersMusicPlayer}">
                <ToggleSwitch IsChecked="{Binding PrefersMusicPlayer}" />
            </controls:Setting>
            <controls:Setting Title="{x:Static locales:Locale.Media_AllowBrowserMedia}">
                <ToggleSwitch IsChecked="{Binding AllowBrowserMedia}" />
            </controls:Setting>
        </StackPanel>
    </ScrollViewer>
</UserControl>
