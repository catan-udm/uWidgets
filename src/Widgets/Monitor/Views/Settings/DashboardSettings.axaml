<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:uWidgets.Views.Controls;assembly=uWidgets"
             xmlns:locales="clr-namespace:Monitor.Locales"
             xmlns:viewModels="clr-namespace:Monitor.ViewModels"
             x:Class="Monitor.Views.Settings.DashboardSettings"
             x:DataType="viewModels:DashboardSettingsViewModel">
    <ScrollViewer>
        <StackPanel Orientation="Vertical" Spacing="5">
            <controls:Setting Title="{x:Static locales:Locale.Monitor_Dashboard_FourthMetric}">
                <ComboBox ItemsSource="{Binding FourthMetricTypes}" MinWidth="130"
                          SelectedItem="{Binding SelectedFourthMetric}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="viewModels:MetricTypeViewModel">
                            <TextBlock Text="{Binding Title}" Margin="0 4" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:Setting>
            <controls:Setting Title="{x:Static locales:Locale.Monitor_Dashboard_ShowLabels}">
                <ToggleSwitch IsChecked="{Binding ShowLabels}" />
            </controls:Setting>
        </StackPanel>
    </ScrollViewer>
</UserControl>
