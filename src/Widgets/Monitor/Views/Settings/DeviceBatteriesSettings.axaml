<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:uWidgets.Views.Controls;assembly=uWidgets"
             xmlns:viewModels="clr-namespace:Monitor.ViewModels"
             x:DataType="viewModels:DeviceBatteriesSettingsViewModel"
             x:Class="Monitor.Views.Settings.DeviceBatteriesSettings">
    <ScrollViewer>
        <StackPanel Orientation="Vertical" Spacing="5">
            <controls:Setting Title="Show percentages">
                <ToggleSwitch IsChecked="{Binding ShowPercentages}" OnContent="" OffContent="" />
            </controls:Setting>
            <controls:Setting Title="Only connected devices">
                <ToggleSwitch IsChecked="{Binding OnlyConnected}" OnContent="" OffContent="" />
            </controls:Setting>
        </StackPanel>
    </ScrollViewer>
</UserControl>
