<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:locales="clr-namespace:Monitor.Locales"
             xmlns:viewModels="clr-namespace:Monitor.ViewModels"
             x:Class="Monitor.Views.DeviceBatteries"
             x:DataType="viewModels:DeviceBatteriesViewModel">
    <Grid>
        <!-- Device List -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasDevices}">
            <ItemsControl ItemsSource="{Binding Devices}" Margin="4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:DeviceBatteryItemViewModel">
                        <Border Margin="0,2,0,4" Padding="6,4" CornerRadius="6"
                                Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <!-- Device Icon -->
                                <PathIcon Grid.Column="0" Data="{Binding Icon}" 
                                          Width="18" Height="18" Margin="0,0,8,0"
                                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          Opacity="0.85" VerticalAlignment="Center" />

                                <!-- Device Name and Mini Battery Bar -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding BatteryPercent}"
                                                 Height="4" CornerRadius="2"
                                                 Foreground="{Binding StatusBrush}"
                                                 Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
                                </StackPanel>

                                <!-- Battery Percentage & Status -->
                                <TextBlock Grid.Column="2" Text="{Binding FormattedLevel}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding StatusBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                    IsVisible="{Binding !HasDevices}" Margin="10">
            <PathIcon Data="{x:Static viewModels:MetricIcon.Battery}"
                      Width="28" Height="28" Opacity="0.4"
                      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static locales:Locale.Monitor_DeviceBatteries_Empty}"
                       FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
