<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:locales="clr-namespace:Monitor.Locales"
             xmlns:viewModels="clr-namespace:Monitor.ViewModels"
             x:Class="Monitor.Views.DeviceBatteries"
             x:DataType="viewModels:DeviceBatteriesViewModel">
    <Grid>
        <!-- Standard View (Wide / Large / Extra Large): Icon, Actual Name, and Single Straight Line -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding HasDevices}">
            <!-- Non-Small View -->
            <ItemsControl ItemsSource="{Binding Devices}"
                          IsVisible="{Binding !IsSmallView}"
                          Margin="8,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:DeviceBatteryItemViewModel">
                        <Grid ColumnDefinitions="Auto,2*,1*" VerticalAlignment="Center" Margin="0,5"
                              Background="Transparent"
                              ToolTip.Tip="{Binding TooltipText}">
                            <!-- 1. Device Icon -->
                            <PathIcon Grid.Column="0" Data="{Binding Icon}"
                                      Width="16" Height="16" Margin="0,0,8,0"
                                      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                      Opacity="0.9" VerticalAlignment="Center" />

                            <!-- 2. Actual Reported Device Name -->
                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />

                            <!-- 3. Single Straight Line Centered Horizontally on Text -->
                            <ProgressBar Grid.Column="2" Minimum="0" Maximum="100"
                                         Value="{Binding BatteryPercent}"
                                         Height="4" CornerRadius="2"
                                         Foreground="{Binding StatusBrush}"
                                         Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                         VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Small View (2x2): Max 2x2 Grid of Semicircular / Radial Indicators with Icons and No Text -->
        <Grid IsVisible="{Binding HasDevices}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding SmallDevices}"
                          IsVisible="{Binding IsSmallView}"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="2" Columns="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:DeviceBatteryItemViewModel">
                        <Border Background="Transparent" ToolTip.Tip="{Binding TooltipText}">
                        <Viewbox Stretch="Uniform" MaxWidth="58" MaxHeight="58" Margin="4">
                            <Canvas Width="60" Height="60">
                                <!-- Background Circular Track -->
                                <Path Opacity="0.18" StrokeThickness="5"
                                      Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}">
                                    <Path.Data>
                                        <EllipseGeometry Center="30,30" RadiusX="22" RadiusY="22" />
                                    </Path.Data>
                                </Path>

                                <!-- Device Icon (Centered inside the ring) -->
                                <PathIcon Canvas.Left="19" Canvas.Top="19" Width="22" Height="22"
                                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          Opacity="0.88"
                                          Data="{Binding Icon}" />

                                <!-- Colored Semicircular / Radial Progress Arc -->
                                <Path StrokeThickness="5"
                                      StrokeDashArray="27.6,27.6"
                                      StrokeLineCap="Round"
                                      StrokeDashOffset="{Binding StrokeDashOffset}"
                                      Stroke="{Binding StatusBrush}"
                                      RenderTransformOrigin="30,30">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="-90" />
                                    </Path.RenderTransform>
                                    <Path.Data>
                                        <EllipseGeometry Center="30,30" RadiusX="22" RadiusY="22" />
                                    </Path.Data>
                                </Path>
                            </Canvas>
                        </Viewbox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Empty State -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                    IsVisible="{Binding !HasDevices}" Margin="10">
            <PathIcon Data="{x:Static viewModels:MetricIcon.Battery}"
                      Width="28" Height="28" Opacity="0.4"
                      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static locales:Locale.Monitor_DeviceBatteries_Empty}"
                       FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
