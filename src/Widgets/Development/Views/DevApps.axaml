<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Development.ViewModels"
             x:Class="Development.Views.DevApps"
             x:DataType="viewModels:DevAppsViewModel">
    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="6,4,6,6">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Data="{x:Static viewModels:DevelopmentIcon.NodeGeometry}" Width="16" Height="16"
                          Foreground="#22C55E" />
                <TextBlock Text="Dev Apps" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding HeaderSummary}" FontSize="11" Opacity="0.7"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Apps List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasApps}">
            <ItemsControl ItemsSource="{Binding Apps}" Margin="4,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:DevAppItemViewModel">
                        <Border Margin="0,2,0,3" Padding="6,4" CornerRadius="6"
                                Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <!-- Framework Icon -->
                                <PathIcon Grid.Column="0" Data="{Binding Icon}" Width="16" Height="16"
                                          Margin="2,0,8,0" Opacity="0.85" VerticalAlignment="Center" />

                                <!-- App details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding AppName}" FontSize="11" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                CornerRadius="3" Padding="4,1">
                                            <TextBlock Text="{Binding PortDisplay}" FontSize="9" FontWeight="Medium" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding MemoryDisplay}" FontSize="9" Opacity="0.6" />
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button Classes="small" Command="{Binding OpenBrowserCommand}"
                                            Padding="4" Background="Transparent" ToolTip.Tip="Open in Browser">
                                        <PathIcon Data="{x:Static viewModels:DevelopmentIcon.GlobeGeometry}" Width="12" Height="12"
                                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                    </Button>
                                    <Button Classes="small" Command="{Binding StopCommand}"
                                            Padding="4" Background="Transparent" ToolTip.Tip="Stop Process">
                                        <PathIcon Data="{x:Static viewModels:DevelopmentIcon.StopGeometry}" Width="10" Height="10" Foreground="#EF4444" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                    IsVisible="{Binding !HasApps}">
            <PathIcon Data="{x:Static viewModels:DevelopmentIcon.TerminalGeometry}" Width="28" Height="28" Opacity="0.3"
                      HorizontalAlignment="Center" />
            <TextBlock Text="No Local Dev Servers Active" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
