<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:uWidgets.Views.Controls;assembly=uWidgets"
             xmlns:viewModels="clr-namespace:Development.ViewModels"
             x:DataType="viewModels:DockerSettingsViewModel"
             x:Class="Development.Views.Settings.DockerSettings">
    <ScrollViewer>
        <StackPanel Orientation="Vertical" Spacing="5">
            <controls:Setting Title="Show all containers">
                <ToggleSwitch IsChecked="{Binding ShowAllContainers}" OnContent="" OffContent="" />
            </controls:Setting>
            <controls:Setting Title="Refresh Interval (Seconds)">
                <NumericUpDown Minimum="2" Maximum="120" Value="{Binding RefreshIntervalSeconds}" Width="120" />
            </controls:Setting>
        </StackPanel>
    </ScrollViewer>
</UserControl>
