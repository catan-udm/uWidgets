<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Notes.ViewModels"
             xmlns:controls="clr-namespace:uWidgets.Views.Controls;assembly=uWidgets"
             x:Class="Notes.Views.Controls.NoteLarge"
             x:DataType="viewModels:NoteViewModel"
             Margin="0">
    <Grid RowDefinitions="Auto, Auto, *, Auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlHighlightListAccentLowBrush}"
                Padding="4,4,14,4">
            <Grid ColumnDefinitions="*,Auto">
                <controls:ClickThroughTextBox Grid.Column="0"
                                              CornerRadius="0"
                                              Height="42"
                                              VerticalContentAlignment="Center"
                                              Text="{Binding Title}"
                                              Watermark="Title..."
                                              LostFocus="UpdateTitle"
                                              FontSize="18"
                                              FontWeight="Bold" />
                <Border Grid.Column="1"
                        CornerRadius="8"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                    <TextBlock Text="{Binding CharacterCount}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Opacity="0.7" />
                </Border>
            </Grid>
        </Border>

        <Path Grid.Row="1" Height="1" Margin="0,4,0,0" Stretch="Fill"
              Opacity="0.2" StrokeThickness="2" StrokeDashArray="1,1" StrokeDashOffset="1"
              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}">
            <Path.Data>
                <LineGeometry StartPoint="0,0" EndPoint="1,0" />
            </Path.Data>
        </Path>

        <controls:ClickThroughTextBox Grid.Row="2"
                                      MinHeight="0"
                                      Padding="14,10"
                                      FontSize="14"
                                      Text="{Binding Content}"
                                      Watermark="Take a note (double-click to type)..."
                                      LostFocus="UpdateContent"
                                      AcceptsReturn="True"
                                      TextWrapping="Wrap" />

        <TextBlock Grid.Row="3"
                   Padding="14,4,14,10"
                   Text="{Binding Updated}"
                   FontSize="12"
                   Opacity="0.55" />
    </Grid>
</UserControl>
