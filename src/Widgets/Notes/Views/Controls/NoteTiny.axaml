<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Notes.ViewModels"
             xmlns:controls="clr-namespace:uWidgets.Views.Controls;assembly=uWidgets"
             x:Class="Notes.Views.Controls.NoteTiny"
             x:DataType="viewModels:NoteViewModel"
             Margin="0">
    <Grid RowDefinitions="Auto,*" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <controls:ClickThroughTextBox Grid.Row="0"
                                      CornerRadius="0"
                                      Height="24"
                                      Padding="8,2"
                                      VerticalContentAlignment="Center"
                                      Background="{DynamicResource SystemControlHighlightListAccentLowBrush}"
                                      Text="{Binding Title}"
                                      Watermark="Title..."
                                      LostFocus="UpdateTitle"
                                      FontSize="11"
                                      FontWeight="Bold" />
        <controls:ClickThroughTextBox Grid.Row="1"
                                      MinHeight="0"
                                      Padding="8,4"
                                      FontSize="11"
                                      Text="{Binding Content}"
                                      Watermark="Take a note..."
                                      LostFocus="UpdateContent"
                                      AcceptsReturn="True"
                                      TextWrapping="Wrap" />
    </Grid>
</UserControl>
