<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Calendar.ViewModels"
             xmlns:views="clr-namespace:Calendar.Views"
             x:Class="Calendar.Views.Month"
             x:DataType="viewModels:MonthCalendarViewModel">
    
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="{Binding TextSize, RelativeSource={RelativeSource AncestorType={x:Type views:Month}}}" />
        </Style>
        <Style Selector="TextBlock.weekend:not(.today)">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="TextBlock.today">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAltHighBrush}" />
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,13*">
        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto"
              Margin="{Binding MonthMargin, RelativeSource={RelativeSource AncestorType={x:Type views:Month}}}">
            <TextBlock Grid.Column="0" Text="{Binding Month}" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Content="•" Padding="4,0" FontSize="11" Background="Transparent" BorderThickness="0"
                        IsVisible="{Binding IsViewingOtherMonth}"
                        Command="{Binding ResetToToday}"
                        ToolTip.Tip="Return to current month" />
                <Button Content="‹" Padding="5,0" FontSize="12" Background="Transparent" BorderThickness="0"
                        Command="{Binding PreviousMonth}"
                        ToolTip.Tip="Previous month" />
                <Button Content="›" Padding="5,0" FontSize="12" Background="Transparent" BorderThickness="0"
                        Command="{Binding NextMonth}"
                        ToolTip.Tip="Next month" />
            </StackPanel>
        </Grid>
        <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding Days}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="viewModels:DayViewModel">
                    <Grid>
                        <Viewbox>
                            <Grid Width="100" Height="100">
                                <Ellipse Width="100" Height="100"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding IsToday}"
                                         Fill="{DynamicResource SystemControlHighlightAccentBrush}" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           FontSize="60"
                                           Classes.weekend="{Binding IsWeekend}"
                                           Classes.today="{Binding IsToday}"
                                           Text="{Binding Day}" />
                            </Grid>
                        </Viewbox>
                        
                    </Grid>
                    </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
    
</UserControl>