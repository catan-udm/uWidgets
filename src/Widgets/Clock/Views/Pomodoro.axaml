<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Clock.ViewModels"
             x:Class="Clock.Views.Pomodoro"
             x:DataType="viewModels:PomodoroViewModel">
    <UserControl.Styles>
        <Style Selector="Button.controlBtn">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAltHighBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding PhaseText}"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       Text="{Binding SessionCounterText}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Opacity="0.6" />
        </Grid>

        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,4">
            <Canvas Width="110" Height="110">
                <Path Opacity="0.18" StrokeThickness="8"
                      Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}">
                    <Path.Data>
                        <EllipseGeometry Center="55,55" RadiusX="48" RadiusY="48" />
                    </Path.Data>
                </Path>
                <Path StrokeThickness="8" StrokeDashArray="37.7,37.7" StrokeLineCap="Round"
                      StrokeDashOffset="{Binding StrokeDashOffset}"
                      Stroke="{DynamicResource SystemControlForegroundAccentBrush}"
                      RenderTransformOrigin="55,55">
                    <Path.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Path.RenderTransform>
                    <Path.Data>
                        <EllipseGeometry Center="55,55" RadiusX="48" RadiusY="48" />
                    </Path.Data>
                </Path>
                <StackPanel Canvas.Left="15" Canvas.Top="34" Width="80" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TimeText}"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding TaskTitle}"
                               FontSize="9"
                               Opacity="0.65"
                               MaxWidth="76"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Canvas>
        </Viewbox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <Button Classes="controlBtn" Click="Reset_OnClick">
                <PathIcon Width="12" Height="12"
                          Data="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466" />
            </Button>
            <Button Classes="primaryBtn" Click="StartPause_OnClick">
                <PathIcon Width="13" Height="13" Foreground="{DynamicResource SystemControlForegroundAltHighBrush}" Data="{Binding PlayPauseIcon}" />
            </Button>
            <Button Classes="controlBtn" Click="Skip_OnClick">
                <PathIcon Width="12" Height="12"
                          Data="M12.5 4a.5.5 0 0 0-1 0v3.248L5.233 3.612C4.693 3.3 4 3.678 4 4.308v7.384c0 .63.692 1.01 1.233.697L11.5 8.753V12a.5.5 0 0 0 1 0z" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
