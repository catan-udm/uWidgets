<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Finance.ViewModels"
             x:Class="Finance.Views.Crypto"
             x:DataType="viewModels:CryptoViewModel">
    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="6,4,6,6">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Data="{x:Static viewModels:FinanceIcon.CryptoGeometry}" Width="16" Height="16"
                          Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                <TextBlock Text="Crypto" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Offline"
                           IsVisible="{Binding IsOffline}"
                           FontSize="9" Opacity="0.6" VerticalAlignment="Center" />
                <Button Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding !IsRefreshing}"
                        Padding="5,2" Background="Transparent" ToolTip.Tip="Refresh prices">
                    <TextBlock Text="↻" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Coins List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasCoins}">
            <ItemsControl ItemsSource="{Binding Coins}" Margin="4,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:CryptoItemViewModel">
                        <Border Margin="0,2,0,3" Padding="6,4" CornerRadius="6"
                                ToolTip.Tip="{Binding SummaryTooltip}"
                                Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}">
                            <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                                <!-- Coin info -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Symbol}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Name}" FontSize="9" Opacity="0.6"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Mini Sparkline Chart (hidden on narrow 2x2 tiles) -->
                                <Canvas Grid.Column="1" Width="56" Height="20" Margin="2,0,6,0"
                                        IsVisible="{Binding ShowSparkline}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{Binding SparklineGeometry}"
                                          Stroke="{Binding DeltaBrush}"
                                          StrokeThickness="1.5" />
                                </Canvas>

                                <!-- Price and Change pill -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1">
                                    <TextBlock Text="{Binding FormattedPrice}" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding FormattedChange}" FontSize="9" FontWeight="Medium"
                                                   Foreground="{Binding DeltaBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4"
                    IsVisible="{Binding IsEmpty}" Margin="8">
            <TextBlock Text="No Coins Found" FontSize="11" FontWeight="SemiBold" Opacity="0.65" HorizontalAlignment="Center" />
            <TextBlock Text="Check coin IDs in Settings (e.g. bitcoin, solana)"
                       FontSize="9.5" Opacity="0.5" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
