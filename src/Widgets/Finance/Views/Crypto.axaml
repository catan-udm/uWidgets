<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Finance.ViewModels"
             x:Class="Finance.Views.Crypto"
             x:DataType="viewModels:CryptoViewModel">
    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="6,4,6,6">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Data="{x:Static viewModels:FinanceIcon.CryptoGeometry}" Width="16" Height="16"
                          Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                <TextBlock Text="Crypto" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Coins List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Coins}" Margin="4,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:CryptoItemViewModel">
                        <Border Margin="0,2,0,3" Padding="6,4" CornerRadius="6"
                                Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <!-- Coin info -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1" Width="65">
                                    <TextBlock Text="{Binding Symbol}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Name}" FontSize="9" Opacity="0.6"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Mini Sparkline Chart -->
                                <Canvas Grid.Column="1" Width="60" Height="20" Margin="4,0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{Binding SparklineGeometry}"
                                          Stroke="{Binding DeltaBrush}"
                                          StrokeThickness="1.5" />
                                </Canvas>

                                <!-- Price and Change pill -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1">
                                    <TextBlock Text="{Binding FormattedPrice}" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding FormattedChange}" FontSize="9" FontWeight="Medium"
                                                   Foreground="{Binding DeltaBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
