<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:locales="clr-namespace:Photos.Locales"
             xmlns:viewModels="clr-namespace:Photos.ViewModels"
             x:Class="Photos.Views.Controls.PhotoFrameSmall"
             x:DataType="viewModels:PhotoFrameViewModel"
             Margin="{Binding FrameMargin}">
    <Border ClipToBounds="True" CornerRadius="{Binding FrameCornerRadius}">
        <Panel>
            <Image Source="{Binding CurrentBitmap}"
                   Stretch="{Binding ImageStretch}"
                   IsVisible="{Binding HasImage}" />

            <Grid IsVisible="{Binding ShowPlaceholder}" RowDefinitions="*,Auto,Auto" Margin="12">
                <Viewbox Grid.Row="0" Stretch="Uniform" MaxWidth="64" MaxHeight="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="64" Height="64">
                        <Ellipse Canvas.Left="40" Canvas.Top="12" Width="12" Height="12"
                                 Fill="{DynamicResource SystemControlForegroundAccentBrush}" Opacity="0.85" />
                        <Path Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" Opacity="0.35"
                              Data="M4 52 L22 26 L36 44 L46 32 L60 52 Z" />
                        <Path Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="3" Opacity="0.5"
                              Data="M6 10 H58 A4 4 0 0 1 62 14 V50 A4 4 0 0 1 58 54 H6 A4 4 0 0 1 2 50 V14 A4 4 0 0 1 6 10 Z" />
                    </Canvas>
                </Viewbox>
                <TextBlock Grid.Row="1"
                           Text="{Binding PlaceholderTitle}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Opacity="0.85"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,4,0,0" />
                <TextBlock Grid.Row="2"
                           Text="{Binding PlaceholderDescription}"
                           FontSize="10"
                           Opacity="0.65"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="2"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,2,0,0" />
            </Grid>

            <Grid VerticalAlignment="Bottom" ColumnDefinitions="*,Auto" Margin="8">
                <Border Grid.Column="0"
                        Margin="0,0,6,0"
                        Padding="8,4"
                        CornerRadius="8"
                        Background="#77000000"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding HasCaption}">
                    <TextBlock Text="{Binding Caption}"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <Button Grid.Column="1"
                        Width="26"
                        Height="26"
                        Padding="0"
                        CornerRadius="13"
                        Background="#66000000"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsVisible="{Binding HasMultipleImages}"
                        Click="Next_OnClick">
                    <PathIcon Width="10" Height="10" Foreground="White"
                              Data="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z" />
                </Button>
            </Grid>
        </Panel>
    </Border>
</UserControl>
