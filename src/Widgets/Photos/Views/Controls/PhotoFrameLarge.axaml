<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:locales="clr-namespace:Photos.Locales"
             xmlns:viewModels="clr-namespace:Photos.ViewModels"
             x:Class="Photos.Views.Controls.PhotoFrameLarge"
             x:DataType="viewModels:PhotoFrameViewModel"
             Margin="{Binding FrameMargin}">
    <Border ClipToBounds="True" CornerRadius="{Binding FrameCornerRadius}">
        <Panel>
            <Image Source="{Binding CurrentBitmap}"
                   Stretch="{Binding ImageStretch}"
                   IsVisible="{Binding HasImage}" />

            <Grid IsVisible="{Binding ShowPlaceholder}" RowDefinitions="*,Auto,Auto" Margin="20">
                <Viewbox Grid.Row="0" Stretch="Uniform" MaxWidth="112" MaxHeight="112" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="64" Height="64">
                        <Ellipse Canvas.Left="40" Canvas.Top="12" Width="12" Height="12"
                                 Fill="{DynamicResource SystemControlForegroundAccentBrush}" Opacity="0.85" />
                        <Path Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" Opacity="0.35"
                              Data="M4 52 L22 26 L36 44 L46 32 L60 52 Z" />
                        <Path Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="3" Opacity="0.5"
                              Data="M6 10 H58 A4 4 0 0 1 62 14 V50 A4 4 0 0 1 58 54 H6 A4 4 0 0 1 2 50 V14 A4 4 0 0 1 6 10 Z" />
                    </Canvas>
                </Viewbox>
                <TextBlock Grid.Row="1"
                           Text="{Binding PlaceholderTitle}"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,2" />
                <TextBlock Grid.Row="2"
                           Text="{Binding PlaceholderDescription}"
                           FontSize="12"
                           Opacity="0.65"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
            </Grid>

            <Border VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="12"
                    Padding="9,4"
                    CornerRadius="9"
                    Background="#77000000"
                    IsVisible="{Binding HasMultipleImages}">
                <TextBlock Text="{Binding ImageCounterText}"
                           Foreground="White"
                           FontSize="11"
                           FontWeight="Bold" />
            </Border>

            <Border VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Margin="12"
                    Padding="12,8"
                    CornerRadius="12"
                    Background="#88000000"
                    IsVisible="{Binding HasImage}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding DisplayCaption}"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentFileName}"
                                   IsVisible="{Binding HasCaption}"
                                   Foreground="#CCFFFFFF"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                IsVisible="{Binding HasMultipleImages}">
                        <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                Background="#55FFFFFF"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="Prev_OnClick">
                            <PathIcon Width="11" Height="11" Foreground="White"
                                      Data="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z" />
                        </Button>
                        <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                Background="#55FFFFFF"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="Next_OnClick">
                            <PathIcon Width="11" Height="11" Foreground="White"
                                      Data="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Panel>
    </Border>
</UserControl>
