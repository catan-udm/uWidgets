<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Shortcuts.ViewModels"
             x:Class="Shortcuts.Views.Launcher"
             x:DataType="viewModels:LauncherViewModel">
    <UserControl.Styles>
        <Style Selector="Button.tile">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="6" />
        </Style>
    </UserControl.Styles>

    <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="viewModels:ShortcutItemViewModel">
                <Button Classes="tile" Click="Shortcut_OnClick" ToolTip.Tip="{Binding Name}">
                    <Grid RowDefinitions="*,Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Grid.Row="0" MaxWidth="26" MaxHeight="26" Margin="0,2">
                            <PathIcon Data="{Binding Icon}"
                                      Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                        </Viewbox>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Name}"
                                   IsVisible="{Binding ShowLabel}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="68" />
                    </Grid>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
