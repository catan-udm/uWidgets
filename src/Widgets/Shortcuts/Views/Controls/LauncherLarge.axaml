<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:locales="clr-namespace:Shortcuts.Locales"
             xmlns:viewModels="clr-namespace:Shortcuts.ViewModels"
             x:Class="Shortcuts.Views.Controls.LauncherLarge"
             x:DataType="viewModels:LauncherViewModel"
             Margin="12">
    <UserControl.Styles>
        <Style Selector="Button.card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,4,8">
            <TextBlock Grid.Column="0"
                       Text="{x:Static locales:Locale.Shortcuts_Launcher_Title}"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                       VerticalAlignment="Center" />
            <Border Grid.Column="1"
                    CornerRadius="8"
                    Padding="8,2"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                <TextBlock Text="{Binding Count}"
                           FontSize="12"
                           FontWeight="Bold"
                           Opacity="0.8" />
            </Border>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="viewModels:ShortcutItemViewModel">
                    <Button Classes="card" Click="Shortcut_OnClick" ToolTip.Tip="{Binding Target}">
                        <Grid RowDefinitions="*,Auto">
                            <Border Grid.Row="0"
                                    Width="38" Height="38"
                                    CornerRadius="11"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource SystemControlHighlightListAccentLowBrush}">
                                <Viewbox MaxWidth="20" MaxHeight="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <PathIcon Data="{Binding Icon}"
                                              Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Row="1" Spacing="2" Margin="0,6,0,0">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TargetSummary}"
                                           IsVisible="{Binding ShowLabel}"
                                           FontSize="11"
                                           Opacity="0.6"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
