<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Weather.ViewModels"
             x:Class="Weather.Views.Controls.ForecastWide"
             x:DataType="viewModels:ForecastViewModel">
    <Grid RowDefinitions="Auto,*">
        <!-- Header Section -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top">
                <TextBlock FontSize="15" FontWeight="Bold" 
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding CityName}" />
                <TextBlock FontSize="38" LetterSpacing="-1" Margin="-2,-2,0,0"
                           Text="{Binding CurrentTemperature}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Top">
                <PathIcon HorizontalAlignment="Right" Width="20" Height="20" Margin="0,0,0,2"
                          Foreground="{DynamicResource SystemControlForegroundAccentBrush}" 
                          Data="{Binding CurrentIcon}" />
                <TextBlock FontSize="13" FontWeight="Bold" Opacity="0.5"
                           HorizontalAlignment="Right"
                           Text="{Binding CurrentCondition}" />
                <TextBlock FontSize="13" FontWeight="Bold" Opacity="0.5"
                           HorizontalAlignment="Right"
                           Text="{Binding CurrentMinMax}" />
            </StackPanel>
        </Grid>

        <!-- Hourly Forecast Section -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Disabled" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding HourlyForecast}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:HourlyForecastViewModel">
                        <Grid RowDefinitions="Auto,Auto,Auto" MinWidth="57">
                            <TextBlock Grid.Row="0" Text="{Binding Time}" FontSize="12" Opacity="0.5" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <PathIcon Grid.Row="1" HorizontalAlignment="Center" Width="16" Height="16"
                                      Foreground="{DynamicResource SystemControlForegroundAccentBrush}" 
                                      VerticalAlignment="Center" Margin="0,2"
                                      Data="{Binding Icon}" />
                            <TextBlock Grid.Row="2" Text="{Binding Temperature}" FontSize="13" HorizontalAlignment="Center" FontWeight="Bold" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Margin="-15,0" Orientation="Horizontal" VerticalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
