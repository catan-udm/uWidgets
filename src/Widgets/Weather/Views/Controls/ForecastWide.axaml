<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:uWidgets.Styles;assembly=uWidgets"
             xmlns:viewModels="clr-namespace:Weather.ViewModels"
             x:Class="Weather.Views.Controls.ForecastWide"
             x:DataType="viewModels:ForecastViewModel"
             ToolTip.Tip="{Binding StatusTooltip}">
    <UserControl.Styles>
        <Style Selector="Button.refreshBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="11" />
        </Style>
        <Style Selector="Button.refreshBtn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.35" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*">
        <!-- Header Section -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top">
                <TextBlock FontSize="15" FontWeight="Bold" 
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding CityName}" />
                <TextBlock FontSize="38" LetterSpacing="-1" Margin="-2,-2,0,0"
                           Text="{Binding CurrentTemperature}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,0,0,2">
                    <Button Classes="refreshBtn" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRetry}"
                            VerticalAlignment="Center" ToolTip.Tip="{Binding StatusTooltip}">
                        <PathIcon Width="12" Height="12" Data="{x:Static icons:WidgetIcons.Refresh}" />
                    </Button>
                    <PathIcon Width="20" Height="20"
                              Foreground="{DynamicResource SystemControlForegroundAccentBrush}" 
                              Data="{Binding CurrentIcon}" />
                </StackPanel>
                <TextBlock FontSize="13" FontWeight="Bold" Opacity="0.5"
                           HorizontalAlignment="Right"
                           Text="{Binding CurrentCondition}" />
                <TextBlock FontSize="13" FontWeight="Bold" Opacity="0.5"
                           HorizontalAlignment="Right"
                           Text="{Binding CurrentMinMax}" />
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,2,0,0"
                            IsVisible="{Binding HasErrorBanner}">
                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
                    <Button Content="{Binding RetryButtonText}"
                            Command="{Binding RetryCommand}" IsEnabled="{Binding CanRetry}"
                            FontSize="10" Padding="6,2" CornerRadius="4" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Hourly Forecast Section -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Disabled" 
                      HorizontalScrollBarVisibility="Hidden" 
                      VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding HourlyForecast}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:HourlyForecastViewModel">
                        <Grid RowDefinitions="Auto,Auto,Auto" MinWidth="54">
                            <TextBlock Grid.Row="0" Text="{Binding Time}" FontSize="12" Opacity="0.5" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <PathIcon Grid.Row="1" HorizontalAlignment="Center" Width="16" Height="16"
                                      Foreground="{DynamicResource SystemControlForegroundAccentBrush}" 
                                      VerticalAlignment="Center" Margin="0,2"
                                      Data="{Binding Icon}" />
                            <TextBlock Grid.Row="2" Text="{Binding Temperature}" FontSize="13" HorizontalAlignment="Center" FontWeight="Bold" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
