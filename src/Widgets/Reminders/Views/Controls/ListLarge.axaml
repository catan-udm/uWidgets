<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Reminders.ViewModels"
             xmlns:controls="clr-namespace:uWidgets.Views.Controls;assembly=uWidgets"
             x:Class="Reminders.Views.Controls.ListLarge"
             x:DataType="viewModels:RemindersViewModel"
             Margin="12,6,6,0">
    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" ColumnDefinitions="*, Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0 -3 6 0" FontSize="32" FontWeight="Bold"
                   VerticalAlignment="Top" HorizontalAlignment="Left" Text="{Binding PendingCount}" />
        <Button Grid.Row="0" Grid.Column="1" Content="Clear Completed" FontSize="11" Padding="8,3" CornerRadius="6"
                VerticalAlignment="Top" Margin="0,2,6,0"
                IsVisible="{Binding HasCompleted}" Click="ClearCompleted" />
        <controls:ClickThroughTextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Padding="0" Margin="0 0 8 0" 
                                      MinHeight="16" MinWidth="90" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Bottom"
                                      Text="{Binding ListName}" Watermark="List title..." LostFocus="ListNameChanged"
                                      Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
        <Path Name="Divider" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 8 8 0" 
              Height="1" Stretch="Fill" Opacity="0.2"  StrokeThickness="2"
              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" >
            <Path.Data>
                <LineGeometry StartPoint="0,0" EndPoint="1,0"/>
            </Path.Data>
        </Path>
        <ScrollViewer Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="No reminders yet. Click below to add one."
                           IsVisible="{Binding !Count}"
                           Opacity="0.55"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,10,8,10" />
                <ItemsControl ItemsSource="{Binding Reminders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="viewModels:ReminderItemViewModel">
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto" RowDefinitions="Auto,Auto">
                                <Button Grid.Row="0" Grid.Column="0" Padding="0" Margin="0,-2,0,0" 
                                        DataContext="{Binding}" Click="CompleteReminder" 
                                        Background="Transparent" CornerRadius="12">
                                    <Canvas Width="16" Height="16">
                                        <Ellipse Width="16" Height="16" StrokeThickness="1"
                                                 Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                        
                                        <Ellipse Margin="2" Width="12" Height="12" IsVisible="{Binding Completed}"
                                                 Fill="{DynamicResource SystemControlForegroundAccentBrush}" />
                                    </Canvas>
                                </Button>
                                <controls:ClickThroughTextBox Grid.Row="0" Grid.Column="1" Padding="8,6,0,6" 
                                                              Text="{Binding Title}" TextWrapping="Wrap"
                                                              Opacity="{Binding TitleOpacity}"
                                                              x:DataType="viewModels:ReminderItemViewModel" DataContext="{Binding}" 
                                                              LostFocus="EditReminder" />
                                <Button Grid.Row="0" Grid.Column="2" Content="↑" FontSize="11" Padding="4,1"
                                        Background="Transparent" BorderThickness="0" Opacity="0.45"
                                        VerticalAlignment="Center" ToolTip.Tip="Move up" Click="MoveReminderUp" />
                                <Button Grid.Row="0" Grid.Column="3" Content="×" FontSize="12" Padding="4,1"
                                        Background="Transparent" BorderThickness="0" Opacity="0.5"
                                        VerticalAlignment="Center" ToolTip.Tip="Delete item" Click="DeleteReminder" />
                                <Path Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="1" Stretch="Fill" Opacity="0.2" Margin="8,0"
                                      StrokeThickness="1.5" StrokeDashArray="1,1" StrokeDashOffset="1"
                                      Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" >
                                    <Path.Data>
                                        <LineGeometry StartPoint="0,0" EndPoint="1,0"/>
                                    </Path.Data>
                                </Path>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto, *">
            <Canvas Width="16" Height="16" Margin="1 -1 0 0">
                <Ellipse Width="16" Height="16" StrokeThickness="1" StrokeDashArray="2,2"
                         Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            </Canvas>
            <controls:ClickThroughTextBox Grid.Column="1" LostFocus="CreateReminder" KeyDown="CreateReminderKeyDown" Padding="8,6,0,6" Watermark="Add a new reminder..." />
        </Grid>
    </Grid>
</UserControl>
