<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Reminders.ViewModels"
             x:Class="Reminders.Views.Controls.ListTiny"
             x:DataType="viewModels:RemindersViewModel"
             ToolTip.Tip="{Binding FirstPendingTitle}"
             Margin="10">
    <Grid RowDefinitions="*,Auto">
        <Viewbox Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" MaxHeight="36">
            <TextBlock Text="{Binding PendingCount}"
                       FontSize="34"
                       FontWeight="Bold" />
        </Viewbox>
        <TextBlock Grid.Row="1"
                   Text="{Binding ListName}"
                   FontSize="11"
                   FontWeight="Bold"
                   Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
