<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:uWidgets.Views.Controls"
             xmlns:locales="clr-namespace:uWidgets.Locales"
             x:Class="uWidgets.Views.Controls.Setting">
    <UserControl.Template>
        <ControlTemplate>
            <Border CornerRadius="4" BorderThickness="1" Padding="18"
                    BorderBrush="{DynamicResource ToolTipBorderBrush}" 
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.RowSpan="2" Height="24" VerticalAlignment="Center" Margin="0 0 18 0"
                              IsVisible="{Binding ShowIcon, RelativeSource={RelativeSource AncestorType=controls:Setting}}"
                              Data="{Binding Icon, RelativeSource={RelativeSource AncestorType=controls:Setting}}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=controls:Setting}}" />
                        <TextBlock IsVisible="{Binding SubtitleVisible, RelativeSource={RelativeSource AncestorType=controls:Setting}}" Opacity="0.7" FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=controls:Setting}}" />
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding RestartRequired, RelativeSource={RelativeSource AncestorType=controls:Setting}}">
                            <Border Padding="6,2" CornerRadius="4" Background="#25FFA500" BorderBrush="#80FFA500" BorderThickness="1">
                                <TextBlock FontSize="11" Foreground="#FFD28000"
                                           Text="{x:Static locales:Locale.Settings_RestartRequired}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding AdminRequired, RelativeSource={RelativeSource AncestorType=controls:Setting}}">
                            <Border Padding="6,2" CornerRadius="4" Background="#25FF4444" BorderBrush="#80FF4444" BorderThickness="1">
                                <TextBlock FontSize="11" Foreground="#FFD83B01"
                                           Text="{x:Static locales:Locale.Settings_AdminRequired}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <ContentPresenter Grid.Row="0" Grid.Column="2" Content="{TemplateBinding Content}"
                                      VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </ControlTemplate>
    </UserControl.Template>
</UserControl>
