<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:locales="clr-namespace:uWidgets.Locales"
        xmlns:views="clr-namespace:uWidgets.Views"
        xmlns:controls="clr-namespace:uWidgets.Views.Controls"
        x:Class="uWidgets.Views.Widget"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        SystemDecorations="{Binding WidgetSystemDecorations}"
        ExtendClientAreaToDecorationsHint="{Binding WidgetExtendClientArea}"
        ExtendClientAreaTitleBarHeightHint="0"
        CanResize="False"
        x:DataType="views:Widget"
        Classes="Widget">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{Binding Edit}" Command="{Binding EditWidget}" IsVisible="{Binding ShowEditButton}" />
            <Separator IsVisible="{Binding ShowEditButton}"/>
            <MenuItem Header="{x:Static locales:Locale.Widget_Size}" IsEnabled="False" />
            <MenuItem Header="{x:Static locales:Locale.Widget_Size_Small}" Command="{Binding ResizeSmall}" IsEnabled="{Binding CanResizeWidget}">
                <MenuItem.Icon><CheckBox IsChecked="{Binding IsSmallSize}" IsHitTestVisible="False" BorderThickness="0" Padding="0" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static locales:Locale.Widget_Size_Medium}" Command="{Binding ResizeMedium}" IsEnabled="{Binding CanResizeWidget}">
                <MenuItem.Icon><CheckBox IsChecked="{Binding IsMediumSize}" IsHitTestVisible="False" BorderThickness="0" Padding="0" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static locales:Locale.Widget_Size_Large}" Command="{Binding ResizeLarge}" IsEnabled="{Binding CanResizeWidget}">
                <MenuItem.Icon><CheckBox IsChecked="{Binding IsLargeSize}" IsHitTestVisible="False" BorderThickness="0" Padding="0" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static locales:Locale.Widget_Size_ExtraLarge}" Command="{Binding ResizeExtraLarge}" IsEnabled="{Binding CanResizeWidget}">
                <MenuItem.Icon><CheckBox IsChecked="{Binding IsExtraLargeSize}" IsHitTestVisible="False" BorderThickness="0" Padding="0" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{x:Static locales:Locale.Settings_Advanced_LockPosition_Title}" Command="{Binding ToggleLockPosition}">
                <MenuItem.Icon><CheckBox IsChecked="{Binding IsPositionLocked}" IsHitTestVisible="False" BorderThickness="0" Padding="0" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static locales:Locale.Settings_Advanced_LockSize_Title}" Command="{Binding ToggleLockSize}">
                <MenuItem.Icon><CheckBox IsChecked="{Binding IsSizeLocked}" IsHitTestVisible="False" BorderThickness="0" Padding="0" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static locales:Locale.Widget_Duplicate}" Command="{Binding DuplicateWidget}" />
            <MenuItem Header="{x:Static locales:Locale.Widget_Center}" Command="{Binding ResetToCenter}" IsEnabled="{Binding CanMoveWidget}" />
            <Separator />
            <MenuItem Header="{x:Static locales:Locale.Widget_Remove}" Command="{Binding Remove}" />
            <Separator />
            <MenuItem Header="{x:Static locales:Locale.Settings}" Command="{Binding OpenSettings}" />
        </ContextMenu>
    </Window.ContextMenu> 
    
    <Window.Styles>
        <Style Selector="Border:not(:pointerover) ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        </Style>
        <Style Selector="Border:pointerover ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style Selector=":is(UserControl)">
            <Setter Property="Margin" Value="12" />
        </Style>
        <Style Selector="ToolTip.ResizeHandleToolTip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemChromeHighColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border#Border">
            <Setter Property="Background" Value="{DynamicResource WidgetBackground}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector=":is(Window).LiquidGlass">
            <Setter Property="TransparencyLevelHint" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector=":is(Window).LiquidGlass Border#Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border#ResizeGrip">
            <Setter Property="Opacity" Value="0.15" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#ResizeGrip:pointerover">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
    </Window.Styles>
    
    <Grid>
        <Border CornerRadius="{Binding Radius}"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                ClipToBounds="True"
                Name="Border"
                Width="{Binding Width, RelativeSource={RelativeSource AncestorType=Window}}"
                Height="{Binding Height, RelativeSource={RelativeSource AncestorType=Window}}">
            <Panel>
                <controls:LiquidGlassSurface Name="LiquidGlassSurface"
                                             IsVisible="{Binding IsLiquidGlassEnabled}"
                                             CornerRadius="{Binding Radius}" />
                <ContentPresenter Name="ContentPresenter" />
                <Border Name="ResizeGrip"
                        Width="22" Height="22"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Background="Transparent"
                        Cursor="BottomRightCorner"
                        IsVisible="{Binding CanResizeWidget}"
                        ToolTip.Tip="Drag to resize"
                        PointerPressed="Resize">
                    <Path Width="12" Height="12" Stretch="Uniform"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5"
                          Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                          Data="M1 3A1 1 0 001 5C3 5 5 3 5 1A1 1 0 003 1C3 2 2 3 1 3" />
                </Border>
            </Panel>
        </Border>
    </Grid>
    
</Window>
