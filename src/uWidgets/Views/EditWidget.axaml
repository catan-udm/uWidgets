<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:uWidgets.Views"
        xmlns:locales="clr-namespace:uWidgets.Locales"
        x:Class="uWidgets.Views.EditWidget"
        Background="{DynamicResource SettingsBackground}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="60"
        WindowStartupLocation="CenterOwner"
        Title="{Binding WindowTitle}"
        Width="440" Height="520" MinWidth="360" MinHeight="360" CanResize="True"
        x:DataType="views:EditWidget">
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto, Auto,*"
          Margin="16">
        <PathIcon Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,12,0" Data="{DynamicResource Appearance}" Width="32" Height="32" />
        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Center">
            <TextBlock IsHitTestVisible="False" Text="{Binding WidgetType}" FontSize="14" FontWeight="Bold" />
            <TextBlock IsHitTestVisible="False" Text="{Binding WidgetSubType}" FontSize="12" FontWeight="SemiBold" Opacity="0.5" />
        </StackPanel>
        <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center" Content="{x:Static locales:Locale.Widget_Save}" Click="Close" />
        <ScrollViewer Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <ContentPresenter IsHitTestVisible="True" Content="{Binding Control}" />
        </ScrollViewer>
    </Grid>
</Window>
