<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:uWidgets.Views.Controls"
             xmlns:viewModels="clr-namespace:uWidgets.ViewModels"
             xmlns:globalization="clr-namespace:System.Globalization;assembly=System.Runtime"
             xmlns:locales="clr-namespace:uWidgets.Locales"
             x:Class="uWidgets.Views.Pages.General"
             x:DataType="viewModels:GeneralViewModel">
    <StackPanel Orientation="Vertical" Spacing="3">
        <!-- Inline Restart Banner when Language changes -->
        <Border IsVisible="{Binding LanguageChangedPendingRestart}"
                Margin="0,0,0,12" Padding="14,10" CornerRadius="6"
                Background="#25FFA500" BorderBrush="#80FFA500" BorderThickness="1.5">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,12,0"
                           Text="Display language changed. Restart uWidgets to update all open widgets." />
                <Button Grid.Column="1" Classes="accent" Content="Restart Now" Click="RestartNow_OnClick" />
            </Grid>
        </Border>

        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0 0 0 10" 
                   Text="{x:Static locales:Locale.Settings_General_Startup}"/>
        <controls:Setting Icon="{DynamicResource Play}"
                          Title="{x:Static locales:Locale.Settings_General_Startup_Title}"
                          Subtitle="{x:Static locales:Locale.Settings_General_Startup_Subtitle}">
            <ToggleSwitch IsChecked="{Binding RunOnStartup}" />
        </controls:Setting>
        <controls:Setting Icon="{DynamicResource General}"
                          Title="Show System Tray icon"
                          Subtitle="Keep uWidgets running in the Windows notification area when Settings is closed">
            <ToggleSwitch IsChecked="{Binding ShowTrayIcon}" />
        </controls:Setting>
        <controls:Setting Icon="{DynamicResource SnapPosition}"
                          Title="Widget layering mode"
                          Subtitle="Choose whether widgets stay pinned to the desktop wallpaper or float above windows">
            <ComboBox ItemsSource="{Binding LayeringModes}" MinWidth="220"
                      SelectedItem="{Binding SelectedLayeringMode}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="viewModels:LayeringModeOption">
                        <TextBlock Text="{Binding Name}" Margin="0 4" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:Setting>

        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0 20 0 10" 
                   Text="Global Keyboard Shortcuts"/>
        <Border IsVisible="{Binding HasHotkeyWarnings}"
                Margin="0,0,0,8" Padding="12,8" CornerRadius="6"
                Background="#25FF4444" BorderBrush="#80FF4444" BorderThickness="1">
            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding HotkeyWarningText}" />
        </Border>
        <controls:Setting Icon="{DynamicResource Advanced}"
                          Title="Enable global hotkeys"
                          Subtitle="Control widgets from anywhere in Windows using keyboard shortcuts">
            <ToggleSwitch IsChecked="{Binding HotkeysEnabled}" />
        </controls:Setting>
        <controls:Setting Title="Show / Hide all widgets (Boss Key)"
                          Subtitle="Instantly hide or restore every desktop widget (e.g. Win+Shift+W)"
                          IsEnabled="{Binding HotkeysEnabled}">
            <TextBox MinWidth="150" Text="{Binding ToggleWidgetsHotkey}"
                     Background="{DynamicResource SettingsBackground}" BorderThickness="1" CornerRadius="4" Padding="8,5" />
        </controls:Setting>
        <controls:Setting Title="Lock / Unlock widget positions"
                          Subtitle="Toggle accidental drag protection (e.g. Win+Alt+L)"
                          IsEnabled="{Binding HotkeysEnabled}">
            <TextBox MinWidth="150" Text="{Binding ToggleLockHotkey}"
                     Background="{DynamicResource SettingsBackground}" BorderThickness="1" CornerRadius="4" Padding="8,5" />
        </controls:Setting>
        <controls:Setting Title="Open Settings"
                          Subtitle="Open this Settings window from anywhere (e.g. Ctrl+Shift+U)"
                          IsEnabled="{Binding HotkeysEnabled}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox MinWidth="150" Text="{Binding OpenSettingsHotkey}"
                         Background="{DynamicResource SettingsBackground}" BorderThickness="1" CornerRadius="4" Padding="8,5" />
                <Button Content="Reset" Click="ResetHotkeys_OnClick" />
            </StackPanel>
        </controls:Setting>

        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0 20 0 10" 
                   Text="{x:Static locales:Locale.Settings_General_Language}"/>
        <controls:Setting Icon="{DynamicResource Language}" 
                          Title="{x:Static locales:Locale.Settings_General_Language_Title}"
                          Subtitle="{x:Static locales:Locale.Settings_General_Language_Subtitle}"
                          RestartRequired="True">
            <ComboBox ItemsSource="{Binding Languages}" MinWidth="150"
                      SelectedItem="{Binding Language}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="globalization:CultureInfo">
                        <TextBlock Text="{Binding DisplayName}" Margin="0 4" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:Setting>

        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0 20 0 10" 
                   Text="Updates"/>
        <controls:Setting Icon="{DynamicResource Download}"
                          Title="Check for updates automatically"
                          Subtitle="Notify when a new uWidgets release is available on GitHub">
            <ToggleSwitch IsChecked="{Binding CheckUpdatesAutomatically}" />
        </controls:Setting>
    </StackPanel>
</UserControl>
